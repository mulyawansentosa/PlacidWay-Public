    "messages": [
      "Is adenocarcinoma cancer treatment cheaper in Mexico or Turkey?"
    ],
    "expectedSources": [
      "package-adenocarcinoma"
    ],
    "answerable": true,
    "expect": {
      "sources": true,
      "mustContainAnyGroups": [
        [
          "Turkey"
        ],
        [
          "not listed",
          "does not list",
          "no price",
          "not provide",
          "not specif",
          "could not find",
          "not find",
          "not for Turkey",
          "but not for Turkey",
          "not for turkey",
          "not found",
          "cannot compare",
          "can not compare"
        ]
      ],
      "mustNotContain": [
        "cheaper in Turkey",
        "Turkey is cheaper"
      ],
      "note": "Req 2: compares only if both are in the content. Only Mexico is priced for this treatment, so the answer must say the Turkey price is not listed."
    }
  },
