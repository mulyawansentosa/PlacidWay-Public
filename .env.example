# =============================================================================
# Server / runtime
# =============================================================================
PORT=3000
NODE_ENV=production
SITE_NAME=PlacidWay Assistant
CONTACT_URL=https://www.placidway.com/rfi/5/Alternative-Cancer-Treatment-by-ITC-Immunity-Therapy-Center
DATA_DIR=./data
# Optional. Defaults to $DATA_DIR/chatbot.db.
# DB_PATH=./data/chatbot.db
# pino level: trace|debug|info|warn|error. Defaults to debug in development
# and info in production.
LOG_LEVEL=info
# Admin endpoints stay disabled while this is empty.
ADMIN_TOKEN=change-me-to-a-long-random-value
# Behind Caddy/Docker, trust one proxy hop. Set false if exposed directly.
TRUST_PROXY=1
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# LLM (OpenAI-compatible). The existing FlazCloud AI Gateway / 9Router works.
# =============================================================================
LLM_BASE_URL=https://your-openai-compatible-gateway.example/v1
LLM_API_KEY=
LLM_MODEL=flazhost-agent
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=700
LLM_TIMEOUT_MS=30000

# =============================================================================
# Embeddings (NVIDIA Nemotron 3.5 Embed 1B)
# Leave EMBEDDING_BASE_URL empty to use BM25 only. The client handles
# query/passage input_type automatically for Nemotron 3.5; set
# EMBEDDING_INPUT_TYPE=none for models that reject it.
# =============================================================================
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
EMBEDDING_INPUT_TYPE=
EMBEDDING_TIMEOUT_MS=60000

# =============================================================================
# Crawler / ingest
# =============================================================================
# Use a project URL or the hiring contact page, not a personal email.
CRAWLER_USER_AGENT=PlacidWayAssessmentBot/1.0 (+https://your-domain.example/bot)
CRAWL_DELAY_MS=1100
CRAWL_TIMEOUT_MS=30000
# Poll and refresh changed pages automatically. 0 disables it.
AUTO_REFRESH_MINUTES=15
# On-request stale-while-revalidate. If the last ingest is older than this,
# a background refresh starts without blocking the request. 0 disables it.
STALE_REFRESH_MINUTES=5

# =============================================================================
# Chunking (characters per indexed passage)
# =============================================================================
CHUNK_MAX_CHARS=1100
CHUNK_MIN_CHARS=80
CHUNK_OVERLAP_CHARS=150

# =============================================================================
# Retrieval
# =============================================================================
RETRIEVAL_TOP_K=6
# Calibrated for Nemotron 3.5 Embed 1B; recalibrate if the model changes.
MIN_VECTOR_SIMILARITY=0.35
MIN_BM25_SCORE=2
MIN_TERM_COVERAGE=0.5
RRF_K=60

# =============================================================================
# Sources
# =============================================================================
# Optional override for the 7th source. The default is already set in
# config/sources.js to the canonical global comparison page.
SOURCE_COMPARISON_URL=https://www.placidway.com/search-medical-pricings/Alternative-Medicine/All/1

# =============================================================================
# Deployment (Caddy / Docker)
# =============================================================================
DOMAIN=localhost

# Host ports for Caddy (change if 80/443 are already used)
HTTP_PORT=80
HTTPS_PORT=443
